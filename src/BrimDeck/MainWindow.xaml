<Window x:Class="BrimDeck.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrimDeck" Title="BrimDeck" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="True"
        ShowActivated="False" ShowInTaskbar="False" Width="760" Height="256" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ModelDetailsResources.xaml"/><ResourceDictionary Source="ToolbarResources.xaml"/><ResourceDictionary Source="MusicResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Stage" Background="{x:Null}">
    <!-- Hover state belongs to the zone, so moving between the panel and the strip above it never counts as leaving.
         The zone starts at the island's left edge: its left margin places the island within the window (see SetExpanded). -->
    <Grid x:Name="HoverZone" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{x:Null}"
          MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
      <!-- The shadow is drawn from a cached picture: WPF blurs an effect again whenever anything drawn over it changes (the
           scrolling title, the equalizer, a carousel), and the cache keeps the blurred result (dropped while the island changes
           size or its color, MainWindow.Shadow.cs). The effect must stay on the child for the cache to hold it; the shadow fades on
           ShadowHost, outside the cache, so a fade reuses the picture. ShadowBounds reaches past
           the blur by whole device pixels, so the picture lies on the pixel grid and looks exactly as the shadow drawn
           directly (FitShadowCache). -->
      <Grid x:Name="ShadowHost" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
        <Grid.CacheMode><BitmapCache EnableClearType="False" SnapsToDevicePixels="True"/></Grid.CacheMode>
        <Rectangle x:Name="ShadowBounds" Fill="Transparent" Margin="-20"/>
        <Grid x:Name="IslandShadow" HorizontalAlignment="Left" VerticalAlignment="Top"
              Width="{Binding ActualWidth, ElementName=Island}" Height="{Binding ActualHeight, ElementName=Island}"
              Margin="{Binding Margin, ElementName=Island}" IsHitTestVisible="False">
          <Grid.Effect>
            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.28"/>
          </Grid.Effect>
          <local:IslandBorder Background="{Binding Background, ElementName=Island}" CornerRadius="{Binding CornerRadius, ElementName=Island}"
                              ShoulderRadius="{Binding ShoulderRadius, ElementName=Island}" Inset="1"/>
        </Grid>
      </Grid>
      <!-- In compact form this strip covers the whole bounding box from the screen edge down, including the notch shoulders,
           the rounded corners and the gap above the capsule. It sits below the island so compact content keeps its own hit testing.
           Collapsed, SetExpanded places it at the box HoverExtensionBox gives; open, it stretches across the island again. -->
      <Border x:Name="HoverExtension" Background="#01000000" Height="0" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
      <local:IslandBorder x:Name="Island" HorizontalAlignment="Left" VerticalAlignment="Top" Width="238" Height="32"
              Background="Black" BorderThickness="0" CornerRadius="0,0,12,12" ShoulderRadius="16" MaterialOpacity="1" ClipToBounds="True">
        <!-- The layered window and the island's rounded clip would leave text in grayscale; the surface beneath is always opaque,
             so ClearType is safe here. Text under a fade, a mask or another clip falls back to grayscale until that ends. -->
        <Grid RenderOptions.ClearTypeHint="Enabled">
          <Border x:Name="MusicIndicator" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#FF55555A" CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
          <!-- Compact music, quotas and the clock share the fixed content area; quota alerts take precedence. -->
          <Grid x:Name="Compact" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="CompactScale"/></Grid.RenderTransform>
            <StackPanel x:Name="CompactRings" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel x:Name="CompactAlert" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
          <!-- Pinned to the top and scaled about the top center, so the content recedes toward the screen edge instead of sliding while the panel shrinks. -->
          <Grid x:Name="ExpandedContent" Visibility="Hidden" Opacity="0" Width="{Binding ActualWidth, ElementName=Island}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform><ScaleTransform x:Name="ContentScale"/></Grid.RenderTransform>
            <Grid x:Name="ContentCanvas" Width="760" Height="240" Margin="0" HorizontalAlignment="Center">
              <Grid.RowDefinitions><RowDefinition x:Name="ToolbarRow" Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Grid.Row="1" x:Name="UsageContent" Margin="6,0,6,10"/>
              <Grid Grid.Row="1" x:Name="MonitorContent" Visibility="Collapsed"/>
              <Grid Grid.Row="1" x:Name="ExtensionContent" Visibility="Collapsed">
                <!-- Lifted over a plugin page a switch is arriving at, in the panel's own surface: a WebView that was
                     off screen keeps showing its last composited frame for a few frames after it comes back, and that
                     full-brightness beat is what reads as two pages overlapping. -->
                <Border x:Name="ArrivalVeil" IsHitTestVisible="False" Visibility="Collapsed"/>
              </Grid>
              <Grid Grid.Row="1" x:Name="MusicContent" Visibility="Collapsed"/>
              <!-- What a rebuilt usage or media page replaced, while it leaves (PageHandover). It spans the header row too and is
                   placed where the old content was: the next page's header row may be taller or shorter. -->
              <Grid Grid.Row="0" Grid.RowSpan="2" x:Name="LeavingContent"/>
            </Grid>
              <!-- Keep the toolbar outside the fixed page layout so neither resize direction clips its controls. -->
              <Grid x:Name="Toolbar" Height="{Binding Height.Value, ElementName=ToolbarRow}" VerticalAlignment="Top">
                <!-- The clock is centered on the whole panel; the switches and the settings button sit inside their own insets. -->
                <TextBlock x:Name="ClockLabel" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="{DynamicResource PanelTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Border x:Name="PageSwitch" Background="{DynamicResource PanelSwitchFill}" CornerRadius="8" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                 <Grid>
                 <!-- The chosen page's fill glides between the buttons, as the monitor page's sort pill does (MainWindow.PlacePageCapsule). -->
                 <Border x:Name="PageCapsule" Background="{DynamicResource PanelFillSelected}" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Width="28" Height="24" CornerRadius="6" IsHitTestVisible="False">
                   <Border.RenderTransform><TranslateTransform x:Name="PageCapsuleShift"/></Border.RenderTransform>
                 </Border>
                 <StackPanel Orientation="Horizontal" x:Name="PageButtons">
                <Button x:Name="AIUsageButton" Style="{StaticResource PanelIconButton}" Width="28" Height="24"
                        Click="AIUsage_Click">
                  <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                    <Path Data="M 4,21 L 4,16 M 9,21 L 9,13 M 14,21 L 14,15 M 19,21 L 19,10 M 3,12 L 9,6 L 14,10 L 21,3 M 16,3 L 21,3 L 21,8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Canvas></Viewbox>
                </Button>
                <Button x:Name="MusicPageButton" Style="{StaticResource PanelIconButton}" Width="28" Height="24" Margin="1,0,0,0" Click="MusicPage_Click">
                  <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M 9,18 V 5.5 L 20,3.3 V 16 M 9,18 A 3,3 0 1 1 3,18 A 3,3 0 1 1 9,18 M 20,16 A 3,3 0 1 1 14,16 A 3,3 0 1 1 20,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeLineJoin="Round"/></Canvas></Viewbox>
                </Button>
                <Button x:Name="MonitorPageButton" Style="{StaticResource PanelIconButton}" Width="28" Height="24" Margin="1,0,0,0" Click="MonitorPage_Click">
                  <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M 2,12.5 H 6.5 L 9.5,5 L 14.5,19 L 17.5,12.5 H 22" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                </Button>
                 </StackPanel>
                 </Grid>
                </Border>
                <StackPanel x:Name="ApplicationPages" Margin="82,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                <Grid x:Name="ModelToolbar" Margin="10,0,96,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                  <Button x:Name="MediaSourceButton" Style="{StaticResource PanelSourceButton}" Width="Auto" MaxWidth="150" Padding="8,0" Margin="0,0,2,0" Click="MediaSource_Click" Visibility="Collapsed">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Viewbox x:Name="MediaSourcePin" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <!-- Measured ink: the pin's center sat 1 DIP above the label and chevron. -->
                        <Viewbox.RenderTransform><TranslateTransform Y="1"/></Viewbox.RenderTransform>
                        <Canvas Width="16" Height="16">
                          <Path Data="M9.6,1.6 L14.4,6.4 L12.2,7.3 L9.3,10.2 L9.7,12.8 L8.4,14.1 L1.9,7.6 L3.2,6.3 L5.8,6.7 L8.7,3.8 Z" StrokeThickness="1.5" StrokeLineJoin="Round"
                                Fill="{Binding Foreground, ElementName=MediaSourceButton}" Stroke="{Binding Foreground, ElementName=MediaSourceButton}"/>
                          <Path Data="M5.1,10.9 L1.6,14.4" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, ElementName=MediaSourceButton}"/>
                        </Canvas>
                      </Viewbox>
                      <TextBlock x:Name="MediaSourceLabel" Grid.Column="1" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="12"
                                 Foreground="{Binding Foreground, ElementName=MediaSourceButton}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <!-- The settings window's chevron: the icon font's small chevron, dropped 1 DIP to meet the label's glyphs. -->
                      <TextBlock x:Name="MediaSourceChevron" Grid.Column="2" Text="&#xE96E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="5,1,0,-1"
                                 Foreground="{Binding Foreground, ElementName=MediaSourceButton}" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                  </Button>
                  <Button x:Name="SyncButton" Style="{StaticResource PanelGlyphButton}" Margin="10,0,4,0" VerticalAlignment="Center" Click="Sync_Click">
                    <Grid Width="24" Height="24">
                    <!-- Countdown to the next automatic sync: a static ring filled once a second, 12 o'clock, counterclockwise. -->
                    <Path x:Name="SyncTrack" Stroke="{DynamicResource PanelTrack}" StrokeThickness="1.2" Visibility="Collapsed">
                      <Path.Data><EllipseGeometry Center="12,12" RadiusX="10" RadiusY="10"/></Path.Data>
                    </Path>
                    <Path x:Name="SyncProgress" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                    <Viewbox x:Name="SyncGlyph" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="24" Height="24">
                      <Path x:Name="SyncArrows" Data="M 3,11 A 9,9 0 0 1 18.4,5.6 L 21,8 M 21,3 L 21,8 L 16,8 M 21,13 A 9,9 0 0 1 5.6,18.4 L 3,16 M 3,21 L 3,16 L 8,16"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                        <Path.RenderTransform><RotateTransform x:Name="SyncRotation" CenterX="12" CenterY="12"/></Path.RenderTransform>
                      </Path>
                      <Path x:Name="SyncSlash" Data="M 4,4 L 20,20" Visibility="Collapsed" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid></Viewbox>
                    </Grid>
                  </Button>
                  <Button x:Name="SettingsButton" Style="{StaticResource PanelSettingsButton}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Click="Settings_Click"/>
                </StackPanel>
              </Grid>
          </Grid>
        </Grid>
      </local:IslandBorder>
    </Grid>
  </Grid>
</Window>
